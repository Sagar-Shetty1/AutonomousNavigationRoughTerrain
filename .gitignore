# MATLAB and Simulink generated files
/slprj/
**/slprj/
*.slxc
*.asv
*.autosave

# Exclude MAT files by default
*.mat

# Required root-level project data
!/scenarioConfig_customization_physical_80s.mat
!/offRoadResults.mat

# Keep only the three selected root-level Simulink models
*.slx
!OffRoadMultibodyStage1_TireDamping_Cz20_20261101.slx
!OffRoadMultibodyStage1_Demo_20261101.slx
!OffRoadMultibodyStage1_OnlineReplanCheckpoint.slx

# Temporary staging copies; root files remain authoritative
/Simulink_Models/
/Robot_Geometry/
/Scenario_Configuration/
/Results/Performance_Metrics/

# Local archives and backups
/Archive/
/backups/
*.zip

# MATLAB workspace dump
/matlab.mat

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

